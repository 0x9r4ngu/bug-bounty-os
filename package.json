{
  "name": "bug-bounty-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --experimental-sqlite --disable-warning=ExperimentalWarning --import tsx server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node --experimental-sqlite --disable-warning=ExperimentalWarning --import tsx server/index.ts",
    "qa": "node qa/smoke.mjs && node qa/interactive.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "fastify": "^5.2.1",
    "nanoid": "^5.0.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.3.1",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-query": "^5.64.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@uiw/react-codemirror": "^4.23.7",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "date-fns": "^4.1.0",
    "dompurify": "^3.2.3",
    "echarts": "^5.6.0",
    "echarts-for-react": "^3.0.2",
    "lucide-react": "^0.469.0",
    "marked": "^15.0.6",
    "puppeteer-core": "^23.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
